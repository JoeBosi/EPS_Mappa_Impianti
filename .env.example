# ============================================
# EPS Mappa Impianti - Configurazione API
# ============================================
# Copia questo file in .env e inserisci le tue API key
# NON committare .env (è già in .gitignore)

# --------------------------------------------
# GOOGLE SHEETS API (Nuovo - Sostituisce GitHub CSV)
# --------------------------------------------
# 1. Vai su https://console.cloud.google.com/
# 2. Crea nuovo progetto
# 3. Abilita "Google Sheets API"
# 4. Crea credenziali > API Key
# 5. (Opzionale) Restringi a HTTP Referrer per sicurezza

GOOGLE_SHEETS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID dello spreadsheet (dal link)
# Esempio: https://docs.google.com/spreadsheets/d/1ldv_2mf2uQOiwXgiMa6ihUt5wIHU6Cu0O2ApPNyIfKE/edit
GOOGLE_SHEETS_ID=1ldv_2mf2uQOiwXgiMa6ihUt5wIHU6Cu0O2ApPNyIfKE

# Nome del foglio (tab) con i fornitori
GOOGLE_SHEETS_RANGE=Fornitori

# --------------------------------------------
# GITHUB API (Legacy - Solo per backup/rollback)
# --------------------------------------------
# Crea token: https://github.com/settings/tokens
# Scope: repo (full control)

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=JoeBosi
GITHUB_REPO=EPS_Mappa_Impianti

# --------------------------------------------
# MAPPE / GEOCODING
# --------------------------------------------
# Non richiesto - usa Nominatim (OpenStreetMap, gratuito)

# --------------------------------------------
# NOTE
# --------------------------------------------
# - Il file .env NON deve essere committato
# - Per GitHub Pages, le API key vanno inserite nel codice
#   o usare proxy server (limitazione GitHub Pages statico)
# - Per sicurezza, restringi API key ai domini specifici
